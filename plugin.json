{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "bidrock",
  "version": "0.1.0",
  "description": "Search procurement, consult Bidrock assistants and manage your workspace tasks.",
  "author": {
    "name": "UAB Bidrock",
    "email": "hello@bidrock.io",
    "url": "https://bidrock.io"
  },
  "homepage": "https://bidrock.io",
  "keywords": [
    "procurement",
    "tenders",
    "awards",
    "tasks"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Bidrock",
        "shortDescription": "Procurement and workspace collaboration.",
        "longDescription": "Connect your Bidrock workspace to search tenders, awards and plans, ask procurement assistants, save searches and collaborate on tasks.",
        "developerName": "UAB Bidrock",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": "Find relevant tenders in my Bidrock workspace and help me evaluate the best matches.",
        "websiteURL": "https://bidrock.io",
        "privacyPolicyURL": "https://bidrock.io/legal/privacy-policy",
        "termsOfServiceURL": "https://bidrock.io/legal/terms-conditions",
        "brandColor": "#163f3d",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png"
      }
    }
  }
}
